# Factiq — variables d'environnement

# Base SQLite (par défaut, aucune configuration nécessaire)
DATABASE_URL="file:../db/custom.db"

# URL publique du site (SEO : canoniques, sitemap, robots, OpenGraph).
# À définir avec votre domaine réel en production.
# NEXT_PUBLIC_SITE_URL="https://factiq.fr"

# Stripe Checkout — optionnel : sans clé, le paiement affiche un message
# explicite et tout le reste de l'app fonctionne.
# Mode test : créer les produits Prix Pro (9 €/mois) et Bureau (29 €/mois)
# sur dashboard.stripe.com/test/products, puis coller les identifiants.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxx      # abonnement Pro 9 €/mois
# STRIPE_PRICE_BUREAU=price_xxxxxxxxxxxxxxxx   # abonnement Bureau 29 €/mois
# Passage en production : remplacer sk_test_/price_ par les identifiants
# de l'onglet « Données de test » désactivé (clés live).
