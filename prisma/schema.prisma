generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // Identité émettrice (mentions légales de facturation)
  legalName    String?
  siret        String?
  siretNic     String?
  vatNumber    String?
  address      String?
  zip          String?
  city         String?
  iban         String?
  // "standard" (assujetti TVA) | "franchise" (art. 293 B du CGI)
  vatMode      String    @default("standard")
  // free | pro
  plan         String    @default("free")
  createdAt    DateTime  @default(now())
  sessions     Session[]
  counters     InvoiceCounter[]
  clients      Client[]
  invoices     Invoice[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  address   String?
  zip       String?
  city      String?
  siret     String?
  vatNumber String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number         String
  issueDate      String
  dueDate        String
  // draft | sent | paid
  status         String        @default("draft")
  currency       String        @default("EUR")
  // Taux de TVA en CENTIÈMES de pourcentage (20 % → 2000, 5,5 % → 550) :
  // aucun montant monétaire en Float (voir src/lib/money.ts et AGENTS.md §2).
  vatRateCentiemes Int         @default(2000)
  vatMode        String        @default("standard")
  paymentTerms   String        @default("Paiement à 30 jours")
  notes          String?
  createdAt      DateTime      @default(now())
  lines          InvoiceLine[]

  @@unique([userId, number])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  // Quantité : grandeur NON monétaire (heures fractionnaires admises).
  quantity       Float   @default(1)
  // Prix unitaire en CENTIMES d'euro (12,30 € → 1230) : entier, jamais Float.
  unitPriceCents Int
  sortOrder      Int     @default(0)
}

// Compteur de numérotation par utilisateur et par année : ne décroît jamais,
// même après suppression d'un brouillon (continuité de numérotation comptable).
model InvoiceCounter {
  userId     String
  year       Int
  lastNumber Int     @default(0)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}
